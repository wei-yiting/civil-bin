# Copy to .env.local. Leave both empty for localStorage demo.
# Supabase Dashboard > Connect > Project URL (without /rest/v1/).
VITE_SUPABASE_URL=
# Supabase Dashboard > Settings > API Keys > Publishable key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set these same two values in Vercel > Project > Settings > Environment Variables.
# No Vercel token or database password is used by this application.
# Never put secret / service_role keys in VITE_ variables.
