{
  "name": "civil-bin",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/standalone.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts server api *.ts *.json .github README.md docs/*.md",
    "format:check": "prettier --check src tests scripts server api *.ts *.json .github README.md docs/*.md",
    "data:update": "node --experimental-strip-types scripts/update-bins.mjs",
    "test:db": "node scripts/test-db.mjs",
    "seed:cloud": "node scripts/seed-cloud.mjs",
    "seed:stores": "node scripts/generate-demo-stores.mjs",
    "test:functions": "node scripts/test-functions.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "leaflet": "^1.9.4",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
